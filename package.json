{
  "name": "@absolutejs/rag",
  "version": "0.7.0",
  "homepage": "https://github.com/absolutejs/rag",
  "bugs": {
    "url": "https://github.com/absolutejs/rag/issues"
  },
  "license": "BSL-1.1",
  "description": "Standalone RAG ingestion, sync, retrieval, evaluation, clients, and framework adapters extracted from AbsoluteJS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./adapter-kit": {
      "import": "./dist/adapter-kit/index.js",
      "types": "./dist/src/adapter-kit/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/src/client/index.d.ts"
    },
    "./client/ui": {
      "import": "./dist/client/ui.js",
      "types": "./dist/src/client/ui.d.ts"
    },
    "./ui": {
      "import": "./dist/presentation/ui.js",
      "types": "./dist/src/presentation/ui.d.ts"
    },
    "./quality": {
      "import": "./dist/quality/quality.js",
      "types": "./dist/src/quality/quality.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/src/react/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/src/vue/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.js",
      "types": "./dist/src/svelte/index.d.ts"
    },
    "./angular": {
      "import": "./dist/angular/index.js",
      "types": "./dist/src/angular/index.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/src/manifest.d.ts"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/ai": {
        "artifactImports": [
          "@absolutejs/ai",
          "@absolutejs/ai/angular",
          "@absolutejs/ai/client",
          "@absolutejs/ai/react",
          "@absolutejs/ai/vue"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": false,
        "range": ">=0.0.46 <0.1",
        "tested": "0.0.47"
      },
      "@absolutejs/sync": {
        "artifactImports": [
          "@absolutejs/sync/engine"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": false,
        "range": ">=2.9.1 <3",
        "tested": "2.11.0"
      },
      "@angular/core": {
        "artifactImports": [
          "@angular/core"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": true,
        "range": "^21.0.0",
        "tested": "21.2.6"
      },
      "elysia": {
        "artifactImports": [
          "elysia"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": false,
        "range": "^1.4.18",
        "tested": "1.4.29"
      },
      "react": {
        "artifactImports": [
          "react"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": true,
        "range": "^19.2.0",
        "tested": "19.2.1"
      },
      "svelte": {
        "artifactImports": [
          "svelte/store"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": true,
        "range": "^5.35.2",
        "tested": "5.55.0"
      },
      "vue": {
        "artifactImports": [
          "vue"
        ],
        "artifactReferences": [],
        "buildExternals": [],
        "optional": true,
        "range": "^3.5.27",
        "tested": "3.5.27"
      }
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.7.2",
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "elysia": "^1.4.18",
    "react": "^19.2.0",
    "svelte": "^5.35.2",
    "vue": "^3.5.27",
    "@absolutejs/sync": ">=2.9.1 <3",
    "@absolutejs/ai": ">=0.0.46 <0.1"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@absolutejs/absolute": "0.19.0-beta.1115",
    "@absolutejs/rag-postgres": "0.0.11",
    "@absolutejs/rag-sqlite": "0.0.11",
    "@angular/core": "21.2.6",
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.0",
    "elysia": "1.4.29",
    "eslint": "^10.0.3",
    "eslint-plugin-absolute": "^0.2.6",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.4.0",
    "prettier": "^3.5.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "svelte": "5.55.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vue": "3.5.27",
    "@absolutejs/sync": "2.11.0",
    "@absolutejs/ai": "0.0.47"
  },
  "scripts": {
    "build": "bun run scripts/build.ts && absolute-manifest emit",
    "config": "absolute config",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "bun test",
    "release": "bun run build && bun publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "adapter-kit": [
        "dist/src/adapter-kit/index.d.ts"
      ],
      "client": [
        "dist/src/client/index.d.ts"
      ],
      "client/ui": [
        "dist/src/client/ui.d.ts"
      ],
      "ui": [
        "dist/src/presentation/ui.d.ts"
      ],
      "quality": [
        "dist/src/quality/quality.d.ts"
      ],
      "react": [
        "dist/src/react/index.d.ts"
      ],
      "vue": [
        "dist/src/vue/index.d.ts"
      ],
      "svelte": [
        "dist/src/svelte/index.d.ts"
      ],
      "angular": [
        "dist/src/angular/index.d.ts"
      ],
      "manifest": [
        "dist/src/manifest.d.ts"
      ]
    }
  }
}
